<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#4f46e5" />
<script>
    // Tanlangan mavzu sahifa chizilishidan oldin qo'llanadi (oq-qora "miltillash" bo'lmasin)
    (function () { try { var t = localStorage.getItem("nv-theme"); if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t); } catch (e) { } })();
</script>
